@startuml
skinparam classAttributeIconSize 0

' --- Énumérations ---
enum Langue {
    FRANCAIS
    ANGLAIS
    ITALIEN
    ESPAGNOL
    ALLEMAND
}

' --- Classes Abstraites et Interfaces ---
abstract class ElementMusical {
    - id : String
    - titre : String
    - duree : int
    - contenu : String
    + {abstract} afficherDetails() : void
    + getTitre() : String
    + getDuree() : int
}

interface "Comparator<T>" as Comparator {
    + compare(o1: T, o2: T) : int
}

' --- Classes de données ---
class Chanson extends ElementMusical {
    - artiste : String
    + getArtiste() : String
    + afficherDetails() : void
}

class LivreAudio extends ElementMusical {
    - auteur : String
    - langue : Langue
    + getAuteur() : String
    + getLangue() : Langue
    + afficherDetails() : void
}

class Playlist {
    - id : String
    - nom : String
    - elements : List<ElementMusical>
    + ajouterElement(e : ElementMusical) : void
    + supprimerElement(e : ElementMusical) : void
    + getElements() : List<ElementMusical>
}

' --- Comparateurs (Logique de tri) ---
class ArtisteComparator implements Comparator {
    + compare(c1: Chanson, c2: Chanson) : int
}

class DureeComparator implements Comparator {
    + compare(l1: LivreAudio, l2: LivreAudio) : int
}

class TitreComparator implements Comparator {
    + compare(e1: ElementMusical, e2: ElementMusical) : int
}

' --- Relations ---
Playlist "1" *-- "0..*" ElementMusical : contient >
LivreAudio --> Langue : utilise >

@enduml